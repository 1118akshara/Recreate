<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- AR VIEW -->
    <fragment
        android:id="@+id/arFragment"
        android:name="com.btech.recreate.ar.CustomArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP INFO PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/txt_object_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Object 1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Measure Height (tap two points)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- LIVE MEASUREMENT DISPLAY -->
    <TextView
        android:id="@+id/txt_live_measurement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00 cm"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#88000000"
        android:padding="16dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="120dp" />

    <!-- CAPTURE BUTTON -->
    <Button
        android:id="@+id/btn_capture_view"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Capture Image"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_gravity="bottom"
        android:layout_margin="16dp" />

</FrameLayout>
