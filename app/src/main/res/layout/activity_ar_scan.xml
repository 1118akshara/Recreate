<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- AR Fragment -->
    <fragment
        android:id="@+id/arFragment"
        android:name="com.btech.recreate.ar.CustomArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- UI Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="top"
        android:background="@android:color/transparent">

        <!-- Object Info -->
        <TextView
            android:id="@+id/txt_object_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Object 1"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Instruction -->
        <TextView
            android:id="@+id/txt_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Measure Height"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Spacer -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Live Measurement -->
        <TextView
            android:id="@+id/txt_live_measurement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 cm"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:background="#80000000"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Capture Button -->
        <Button
            android:id="@+id/btn_capture_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture Image"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</FrameLayout>