<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============================= -->
    <!-- AR CAMERA LAYER -->
    <!-- ============================= -->
    <fragment
        android:id="@+id/arFragment"
        android:name="com.btech.recreate.ar.CustomArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ============================= -->
    <!-- BOUNDING BOX OVERLAY -->
    <!-- ============================= -->
    <View
        android:id="@+id/boundingBoxOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="260dp"
        android:layout_gravity="center"
        android:background="@drawable/bounding_box_outline"
        android:clickable="false"
        android:focusable="false" />

    <!-- ============================= -->
    <!-- TOP INFO BAR -->
    <!-- ============================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/txt_object_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Object 1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Measure Height (tap two points)"
            android:textColor="#DDFFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- ============================= -->
    <!-- LIVE MEASUREMENT BADGE -->
    <!-- ============================= -->
    <TextView
        android:id="@+id/txt_live_measurement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00 cm"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#88000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="140dp" />

    <!-- ============================= -->
    <!-- BOTTOM ACTION PANEL -->
    <!-- ============================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#CC0E3B2E">

        <Button
            android:id="@+id/btn_capture_view"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Capture Image"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_next_object"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Scan Next Object"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:backgroundTint="#81C784"
            android:textColor="#003300" />

        <Button
            android:id="@+id/btn_finish"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Finish Scan"
            android:textAllCaps="false"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:backgroundTint="#A5D6A7"
            android:textColor="#003300" />

    </LinearLayout>

</FrameLayout>

