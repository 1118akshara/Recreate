<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/arFragment"
        android:name="com.btech.recreate.ar.CustomArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#88000000">

        <TextView
            android:id="@+id/txt_object_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Object 1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/txt_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture Front View"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <Button
            android:id="@+id/btn_capture_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture View"/>

        <Button
            android:id="@+id/btn_next_object"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan Next Object"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btn_finish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finish Scan"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</FrameLayout>
