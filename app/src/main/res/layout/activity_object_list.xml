<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved Objects"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Objects will be added dynamically here -->

        <Button
            android:id="@+id/btnScanNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan Next Object"
            android:layout_marginTop="24dp"/>

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyze Objects (AI)"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnReuse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reuse Suggestions"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finish Scan"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>